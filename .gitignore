# data artifacts (raw/interim/processed are reproducible via pipeline)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# secrets (local DB credentials etc.; never commit)
.env

# python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# experiment tracking / hydra
outputs/
multirun/
wandb/
runs/

# editors & OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# model checkpoints & training artifacts (binary; metrics/history/diagnosis
# text files are deliberately KEPT so results stay reviewable in the repo).
# Global patterns on purpose: the models/**-scoped versions left binaries at
# any other path one `git add -A` away from entering history permanently.
*.pt
# SB3 replay buffer (large; only needed to resume training)
*.pkl
# SB3 RL checkpoints (best/last)
*.zip
.claude/

# Per-run training-loss curves. 52 files, 1.8 MB, and none is cited by either
# README or any doc — they only show that training converged. The diagnosis
# figures are kept: those carry per-horizon comparisons that the docs cite.
reports/figures/learning_curve_*.png

# script run logs at the repo root (build_dataset.log, train_forecast.log,
# diagnose_forecast.log, ...) — regenerated on every run, pure churn in diffs.
# The ones already committed stay tracked until untracked explicitly:
#   git rm --cached *.log
*.log

# Task 08 per-item dispatch cache: 3,354 intermediate JSONs, regenerable from
# the commands in docs/experiments/08-forecast-value-log.md and resumable.
# The published record is models/comparison/block_b/comparison.json, the four
# tiers/ subdirectories, the two .md tables and the log itself.
# models/comparison/cache/ (task 04, 241 files) stays tracked: log section 1 is
# a re-aggregation of exactly those files.
models/comparison/block_b/cache/
